# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# Local: postgres://postgres:postgres@localhost:5432/thabang
# Neon:  postgres://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/thabang
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30m
# Comma-separated list of front-end URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173
